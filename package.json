{
	"name": "obsidian-worldbuilding-maps",
	"version": "1.0.0",
	"description": "View layer for Obsidian tailored for worldbuilding maps",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [],
	"license": "0-BSD",
	"dependencies": {
		"d3-selection": "3.0.0",
		"d3-zoom": "3.0.0",
		"obsidian": "latest"
	},
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/d3-zoom": "3.0.8",
		"@types/node": "25.5.0",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"prettier": "^3.7.4",
		"tslib": "2.4.0",
		"typescript": "5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "4.1.2"
	}
}
